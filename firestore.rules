rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in AND email verified. Used by everything except reading your own profile.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // A person's profile. Only they can read it. After creation they may change only their icon.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'avatar', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.username.lower() == request.resource.data.usernameLower
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 8
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid;
      allow update: if verified() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar'])
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 8;
      allow delete: if false;
    }

    // Username reservations. Anyone may check one name (needed at sign-up) but nobody can list them.
    // Only a verified person can reserve, and only the one name that matches their own profile.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if verified()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == name;
      allow update, delete: if false;
    }

    // Tournaments. The document id is the share code.
    // Anyone verified who knows the code can read it. Only the host can create, change or delete it.
    function validTournament() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerId', 'ownerName', 'name', 'game', 'sport', 'format', 'status', 'championName', 'createdAt', 'updatedAt', 'rev', 'data'])
        && d.ownerId == request.auth.uid
        && d.ownerName is string && d.ownerName.size() <= 20
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.game is string && d.game.size() <= 40
        && d.sport in ['football', 'cricket', 'tekken']
        && d.format in ['league', 'knockout', 'groups']
        && d.status in ['running', 'finished']
        && (d.championName == null || (d.championName is string && d.championName.size() <= 60))
        && d.createdAt is number
        && d.updatedAt == request.time
        && d.rev is int
        && d.data is string && d.data.size() <= 900000;
    }
    match /tournaments/{code} {
      allow get: if verified();
      allow list: if verified() && resource.data.ownerId == request.auth.uid;
      allow create: if verified() && code.matches('^[A-HJ-NP-Z2-9]{6}$') && validTournament() && request.resource.data.rev == 1;
      allow update: if verified() && resource.data.ownerId == request.auth.uid && validTournament()
        && request.resource.data.rev == resource.data.rev + 1;
      allow delete: if verified() && resource.data.ownerId == request.auth.uid;
    }

    // Tournaments a person follows (used by the next update).
    match /users/{uid}/following/{code} {
      allow read, delete: if verified() && request.auth.uid == uid;
      allow create, update: if verified() && request.auth.uid == uid
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['code', 'name', 'game', 'ownerName', 'followedAt'])
        && request.resource.data.code == code
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.game is string && request.resource.data.game.size() <= 40
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 20
        && request.resource.data.followedAt is number;
    }
  }
}
